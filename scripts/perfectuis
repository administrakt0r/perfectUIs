#!/bin/sh
# perfectUIs launcher. `detect` runs the Python scanner in this directory.
set -eu

dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

usage() {
  cat <<'EOF'
perfectuis — frontend craft detector

Usage:
  perfectuis detect [--json] [--scope layout|type|color|a11y|motion|all] [path...]
  perfectuis detect --rules
  perfectuis help

Scans HTML, CSS, and component source for craft-floor defects.
Exit 0 when the scan is clean, 1 when findings exist, 2 on usage errors.
EOF
}

if [ "$#" -eq 0 ]; then
  usage >&2
  exit 2
fi

cmd=$1
shift

case "$cmd" in
  -h|--help|help)
    usage
    exit 0
    ;;
  detect)
    if ! command -v python3 >/dev/null 2>&1; then
      echo "python3 is required to run the perfectUIs detector." >&2
      exit 1
    fi
    exec python3 "$dir/detect.py" "$@"
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
